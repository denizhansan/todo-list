pipeline {

    agent {
        node {
            label 'todo-jenkins-agent'
        }
    }

    parameters {

        choice(
            name: 'BUILD_TYPE',
            choices: [
                'PR',
                'TOTAL_BUILD'
            ],
            description: 'Pipeline trigger type'
        )

        string(
            name: 'PR_NUMBER',
            defaultValue: '',
            description: 'Pull Request number. Required only for PR builds.'
        )
    }


    stages {

        stage('Checkout') {

            steps {

                script {

                    if (params.BUILD_TYPE == 'PR') {

                        echo "Checking out PR #${params.PR_NUMBER}"

                        checkout([
                            $class: 'GitSCM',

                            branches: [[
                                name: "refs/remotes/origin/pr/${params.PR_NUMBER}/head"
                            ]],

                            userRemoteConfigs: [[

                                url: 'https://github.com/denizhansan/todo-list.git',

                                credentialsId: 'github-creds',

                                refspec:
                                    "+refs/pull/${params.PR_NUMBER}/head:" +
                                    "refs/remotes/origin/pr/${params.PR_NUMBER}/head"
                            ]]
                        ])

                    } else {

                        echo "Checking out develop branch"

                        checkout([
                            $class: 'GitSCM',

                            branches: [[
                                name: '*/develop'
                            ]],

                            userRemoteConfigs: [[

                                url: 'https://github.com/denizhansan/todo-list.git',

                                credentialsId: 'github-creds'
                            ]]
                        ])
                    }
                }
            }
        }


        stage('Read Version') {

            steps {

                script {

                    if (params.BUILD_TYPE == 'PR') {

                        env.FRONTEND_VERSION =
                            "pr-${params.PR_NUMBER}"

                    } else {

                        env.FRONTEND_VERSION =
                            "total-build"
                    }


                    echo "Build type: ${params.BUILD_TYPE}"

                    echo "Frontend version: ${env.FRONTEND_VERSION}"
                }
            }
        }


        stage('Frontend Docker Build') {

            steps {

                dir('frontend') {

                    sh '''
                        docker build \
                            -t denizhansan/todo-frontend:${FRONTEND_VERSION} \
                            .
                    '''
                }
            }
        }
    }


    post {

        success {

            echo 'Frontend module pipeline SUCCESS.'
        }


        failure {

            echo 'Frontend module pipeline FAILED.'
        }


        always {

            sh '''
                docker image rm \
                denizhansan/todo-frontend:${FRONTEND_VERSION} \
                || true
            '''

            cleanWs()
        }
    }
}