pipeline {
    agent {
        node {
            label 'todo-jenkins-agent'
        }
    }

    environment {
        MODULE_CHECK_NAME = 'Module Build Check'

        GITHUB_OWNER = 'denizhansan'
        GITHUB_REPO  = 'todo-list'
    }

    parameters {
        string(
            name: 'PR_NUMBER',
            defaultValue: '',
            description: 'Pull Request number'
        )

        string(
            name: 'SOURCE_BRANCH',
            defaultValue: '',
            description: 'Pull Request source branch'
        )

        choice(
            name: 'TARGET_BRANCH',
            choices: [
                'backend-module',
                'frontend-module'
            ],
            description: 'Pull Request target branch'
        )
    }

    stages {

        stage('Identify Target Module') {
            steps {
                script {

                    if (!params.PR_NUMBER?.trim()) {
                        error 'PR_NUMBER parameter is required.'
                    }

                    if (!params.SOURCE_BRANCH?.trim()) {
                        error 'SOURCE_BRANCH parameter is required.'
                    }

                    echo "PR ID          : ${params.PR_NUMBER}"
                    echo "Source Branch  : ${params.SOURCE_BRANCH}"
                    echo "Target Branch  : ${params.TARGET_BRANCH}"

                    if (params.TARGET_BRANCH == 'backend-module') {
                        env.MODULE_JOB = 'backend-module'
                    }
                    else if (params.TARGET_BRANCH == 'frontend-module') {
                        env.MODULE_JOB = 'frontend-module'
                    }
                    else {
                        publishChecks(
                            name: env.MODULE_CHECK_NAME,
                            title: 'Module Build Check',
                            summary: 'Unsupported PR target branch.',
                            text: "Target branch: ${params.TARGET_BRANCH}",
                            status: 'COMPLETED',
                            conclusion: 'FAILURE'
                        )

                        error(
                            "Unsupported target branch: ${params.TARGET_BRANCH}. " +
                            "PR must target backend-module or frontend-module."
                        )
                    }

                    echo "Selected Module Job: ${env.MODULE_JOB}"
                }
            }
        }

        stage('Run Module Pipeline') {
            steps {
                script {

                    publishChecks(
                        name: env.MODULE_CHECK_NAME,
                        title: 'Module Build Check',
                        summary: "${env.MODULE_JOB} pipeline is running.",
                        text: "Validating PR #${params.PR_NUMBER}.",
                        status: 'IN_PROGRESS'
                    )

                    echo "Starting ${env.MODULE_JOB} pipeline..."
                    echo "Passing PR_NUMBER: ${params.PR_NUMBER}"

                    def moduleBuild = build(
                        job: env.MODULE_JOB,
                        parameters: [
                            string(
                                name: 'PR_NUMBER',
                                value: params.PR_NUMBER
                            )
                        ],
                        wait: true,
                        propagate: false
                    )

                    echo "Module build #${moduleBuild.number}"
                    echo "Module build result: ${moduleBuild.result}"

                    if (moduleBuild.result != 'SUCCESS') {

                        publishChecks(
                            name: env.MODULE_CHECK_NAME,
                            title: 'Module Build Check',
                            summary: "${env.MODULE_JOB} pipeline failed.",
                            text: "PR #${params.PR_NUMBER} cannot be merged.",
                            status: 'COMPLETED',
                            conclusion: 'FAILURE'
                        )

                        error(
                            "${env.MODULE_JOB} pipeline failed. " +
                            "PR cannot be merged."
                        )
                    }

                    publishChecks(
                        name: env.MODULE_CHECK_NAME,
                        title: 'Module Build Check',
                        summary: "${env.MODULE_JOB} pipeline completed successfully.",
                        text: "PR #${params.PR_NUMBER} passed module validation.",
                        status: 'COMPLETED',
                        conclusion: 'SUCCESS'
                    )

                    echo "${env.MODULE_JOB} pipeline completed successfully."
                    echo "${env.MODULE_CHECK_NAME}: SUCCESS"
                    echo "GitHub Ruleset can now allow the PR to be merged."
                }
            }
        }

        stage('Wait for PR Merge') {
            steps {
                script {

                    echo "Waiting for PR #${params.PR_NUMBER} to be merged..."

                    timeout(time: 30, unit: 'MINUTES') {

                        waitUntil(initialRecurrencePeriod: 5000) {

                            def prInfo

                            withCredentials([
                                usernamePassword(
                                    credentialsId: 'github-creds',
                                    usernameVariable: 'GITHUB_USERNAME',
                                    passwordVariable: 'GITHUB_TOKEN'
                                )
                            ]) {

                                prInfo = sh(
                                    script: """
                                        curl -sS \
                                            -u "\$GITHUB_USERNAME:\$GITHUB_TOKEN" \
                                            -H "Accept: application/vnd.github+json" \
                                            https://api.github.com/repos/${GITHUB_OWNER}/${GITHUB_REPO}/pulls/${params.PR_NUMBER}
                                    """,
                                    returnStdout: true
                                ).trim()
                            }

                            def pr = readJSON text: prInfo

                            echo "PR state  : ${pr.state}"
                            echo "PR merged : ${pr.merged}"

                            if (pr.merged == true) {

                                echo "PR #${params.PR_NUMBER} has been merged."

                                return true
                            }

                            if (
                                pr.state == 'closed' &&
                                pr.merged == false
                            ) {

                                error(
                                    "PR #${params.PR_NUMBER} was closed without being merged. " +
                                    "Version Updater will not run."
                                )
                            }

                            echo "PR is still open. Waiting..."

                            return false
                        }
                    }
                }
            }
        }

        stage('Run Version Updater') {
            steps {
                script {

                    echo "PR was merged successfully."
                    echo "Starting Version-updater..."
                    echo "Module: ${env.MODULE_JOB}"

                    def versionBuild = build(
                        job: 'Version-updater',
                        parameters: [
                            string(
                                name: 'MODE',
                                value: 'MODULE'
                            ),
                            string(
                                name: 'MODULE',
                                value: env.MODULE_JOB
                            )
                        ],
                        wait: true,
                        propagate: false
                    )

                    echo "Version Updater build #${versionBuild.number}"
                    echo "Version Updater result: ${versionBuild.result}"

                    if (versionBuild.result != 'SUCCESS') {
                        error(
                            "Version Updater failed for ${env.MODULE_JOB}."
                        )
                    }

                    echo "Version Updater completed successfully."
                }
            }
        }

        /*
        stage('Build Docker Image') {
            steps {
                script {
                    // Yeni version.yaml okunacak.
                    // İlgili backend/frontend image build edilecek.
                }
            }
        }

        stage('Push Image to Nexus') {
            steps {
                script {
                    // nexus-creds ile login.
                    // Image Nexus registry'ye push edilecek.
                }
            }
        }
        */
    }

    post {

        failure {
            echo "PR Pipeline FAILED."
        }

        aborted {
            echo "PR Pipeline ABORTED."
        }

        always {
            cleanWs()
        }
    }
}