pipeline {
    agent {
        node {
            label 'todo-jenkins-agent'
        }
    }

    stages {

        stage('Identify Target Module') {
            steps {
                script {
                    echo "PR ID          : ${env.CHANGE_ID}"
                    echo "Source Branch  : ${env.CHANGE_BRANCH}"
                    echo "Target Branch  : ${env.CHANGE_TARGET}"

                    if (env.CHANGE_TARGET == 'backend-module') {
                        env.MODULE_JOB = 'backend-module'
                    }
                    else if (env.CHANGE_TARGET == 'frontend-module') {
                        env.MODULE_JOB = 'frontend-module'
                    }
                    else {
                        error(
                            "Unsupported target branch: ${env.CHANGE_TARGET}. " +
                            "PR must target backend-module or frontend-module."
                        )
                    }

                    echo "Selected Module Job: ${env.MODULE_JOB}"
                }
            }
        }

        stage('Run Module Pipeline') {
            steps {
                script {
                    echo "Starting ${env.MODULE_JOB} pipeline..."
                    echo "Passing PR_NUMBER: ${env.CHANGE_ID}"

                    def moduleBuild = build(
                        job: env.MODULE_JOB,
                        parameters: [
                            string(
                                name: 'PR_NUMBER',
                                value: env.CHANGE_ID
                            )
                        ],
                        wait: true,
                        propagate: false
                    )

                    echo "Module build #${moduleBuild.number}"
                    echo "Module build result: ${moduleBuild.result}"

                    if (moduleBuild.result != 'SUCCESS') {
                        error(
                            "${env.MODULE_JOB} pipeline failed. " +
                            "PR cannot be merged."
                        )
                    }

                    echo "${env.MODULE_JOB} pipeline completed successfully."
                }
            }
        }

        stage('Check PR Merge Status') {
            steps {
                script {

                    /*
                     * Burada PR'ın merge durumunu kontrol edeceğiz.
                     *
                     * Şimdilik PR build'i olduğu için CHANGE_ID'nin
                     * mevcut olup olmadığını kontrol ediyoruz.
                     *
                     * Gerçek merged kontrolü daha sonra GitHub API
                     * üzerinden yapılabilir.
                     */

                    if (env.CHANGE_ID) {
                        env.CHECK_VERSION_UPDATER = 'true'

                        echo "PR #${env.CHANGE_ID} detected."
                        echo "Version Updater check will run."
                    }
                    else {
                        env.CHECK_VERSION_UPDATER = 'false'

                        echo "No PR detected."
                        echo "Version Updater check will be skipped."
                    }
                }
            }
        }

        stage('Check Version Updater') {

            when {
                environment name: 'CHECK_VERSION_UPDATER', value: 'true'
            }

            steps {
                script {

                    echo "Checking Version Updater result..."
                    echo "PR #${env.CHANGE_ID}"

                    /*
                     * Version Updater burada ÇALIŞTIRILMIYOR.
                     *
                     * Burada sadece daha önce çalışmış olan
                     * Version Updater sonucunu kontrol edeceğiz.
                     */

                    echo "Version Updater check is enabled."
                }
            }
        }
    }

    post {

        success {
            echo "PR checks SUCCESS."
            echo "You can now merge this Pull Request from GitHub."
        }

        failure {
            echo "PR checks FAILED."
            echo "Pull Request should not be merged."
        }

        aborted {
            echo "PR checks ABORTED."
        }

        always {
            cleanWs()
        }
    }
}