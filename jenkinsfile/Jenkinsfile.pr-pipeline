pipeline {
    agent {
        node {
            label 'todo-jenkins-agent'
        }
    }

    environment {
        MODULE_CHECK_NAME = 'Module Build Check'

        GITHUB_OWNER = 'denizhansan'
        GITHUB_REPO  = 'todo-list'

        NEXUS_REGISTRY = 'host.docker.internal:8082'
    }

    stages {

        stage('Identify Target Module') {
            steps {
                script {
                    echo "PR ID          : ${env.CHANGE_ID}"
                    echo "Source Branch  : ${env.CHANGE_BRANCH}"
                    echo "Target Branch  : ${env.CHANGE_TARGET}"

                    if (env.CHANGE_TARGET == 'backend-module') {

                        env.MODULE_JOB = 'backend-module'
                        env.MODULE_DIR = 'backend'
                        env.IMAGE_NAME = 'todo-backend'

                    }
                    else if (env.CHANGE_TARGET == 'frontend-module') {

                        env.MODULE_JOB = 'frontend-module'
                        env.MODULE_DIR = 'frontend'
                        env.IMAGE_NAME = 'todo-frontend'

                    }
                    else {

                        publishChecks(
                            name: env.MODULE_CHECK_NAME,
                            title: 'Module Build Check',
                            summary: 'Unsupported PR target branch.',
                            text: "Target branch: ${env.CHANGE_TARGET}",
                            status: 'COMPLETED',
                            conclusion: 'FAILURE'
                        )

                        error(
                            "Unsupported target branch: ${env.CHANGE_TARGET}. " +
                            "PR must target backend-module or frontend-module."
                        )
                    }

                    env.IMAGE_TAG = "pr-${env.CHANGE_ID}"

                    echo "Selected Module Job : ${env.MODULE_JOB}"
                    echo "Module Directory    : ${env.MODULE_DIR}"
                    echo "Docker Image        : ${env.IMAGE_NAME}"
                    echo "Docker Image Tag    : ${env.IMAGE_TAG}"
                }
            }
        }

        stage('Run Module Pipeline') {
            steps {
                script {

                    publishChecks(
                        name: env.MODULE_CHECK_NAME,
                        title: 'Module Build Check',
                        summary: "${env.MODULE_JOB} pipeline is running.",
                        text: "Validating PR #${env.CHANGE_ID}.",
                        status: 'IN_PROGRESS'
                    )

                    echo "Starting ${env.MODULE_JOB} pipeline..."
                    echo "Passing PR_NUMBER: ${env.CHANGE_ID}"

                    def moduleBuild = build(
                        job: env.MODULE_JOB,
                        parameters: [
                            string(
                                name: 'PR_NUMBER',
                                value: env.CHANGE_ID
                            )
                        ],
                        wait: true,
                        propagate: false
                    )

                    echo "Module build #${moduleBuild.number}"
                    echo "Module build result: ${moduleBuild.result}"

                    if (moduleBuild.result != 'SUCCESS') {

                        publishChecks(
                            name: env.MODULE_CHECK_NAME,
                            title: 'Module Build Check',
                            summary: "${env.MODULE_JOB} pipeline failed.",
                            text: "PR #${env.CHANGE_ID} cannot be merged.",
                            status: 'COMPLETED',
                            conclusion: 'FAILURE'
                        )

                        error(
                            "${env.MODULE_JOB} pipeline failed. " +
                            "PR cannot be merged."
                        )
                    }

                    publishChecks(
                        name: env.MODULE_CHECK_NAME,
                        title: 'Module Build Check',
                        summary: "${env.MODULE_JOB} pipeline completed successfully.",
                        text: "PR #${env.CHANGE_ID} passed module validation.",
                        status: 'COMPLETED',
                        conclusion: 'SUCCESS'
                    )

                    echo "${env.MODULE_JOB} pipeline completed successfully."
                    echo "${env.MODULE_CHECK_NAME}: SUCCESS"
                    echo "GitHub Ruleset can now allow the PR to be merged."
                }
            }
        }

        stage('Wait for PR Merge') {
            steps {
                script {

                    echo "Waiting for PR #${env.CHANGE_ID} to be merged..."

                    timeout(time: 30, unit: 'MINUTES') {

                        waitUntil {

                            def prInfo

                            withCredentials([
                                usernamePassword(
                                    credentialsId: 'github-creds',
                                    usernameVariable: 'GITHUB_USERNAME',
                                    passwordVariable: 'GITHUB_TOKEN'
                                )
                            ]) {

                                prInfo = sh(
                                    script: """
                                        curl -sS \
                                            -u "\$GITHUB_USERNAME:\$GITHUB_TOKEN" \
                                            -H "Accept: application/vnd.github+json" \
                                            https://api.github.com/repos/${GITHUB_OWNER}/${GITHUB_REPO}/pulls/${env.CHANGE_ID}
                                    """,
                                    returnStdout: true
                                ).trim()
                            }

                            def pr = readJSON text: prInfo

                            echo "PR state  : ${pr.state}"
                            echo "PR merged : ${pr.merged}"

                            if (pr.merged == true) {

                                echo "PR #${env.CHANGE_ID} has been merged."

                                return true
                            }

                            if (
                                pr.state == 'closed' &&
                                pr.merged == false
                            ) {

                                error(
                                    "PR #${env.CHANGE_ID} was closed without being merged. " +
                                    "Docker image will not be pushed and Version Updater will not run."
                                )
                            }

                            echo "PR is still open. Waiting..."

                            return false
                        }
                    }
                }
            }
        }

        stage('Build & Push Docker Image to Nexus') {
            steps {
                script {

                    echo "Preparing Docker image..."
                    echo "Module    : ${env.MODULE_JOB}"
                    echo "Directory : ${env.MODULE_DIR}"
                    echo "Image     : ${env.NEXUS_REGISTRY}/${env.IMAGE_NAME}:${env.IMAGE_TAG}"

                    dir(env.MODULE_DIR) {

                        sh '''
                            # Dockerfile bulunduğumuz module klasöründe.
                            # Örneğin backend PR ise çalışma dizini backend/ olur.
                            #
                            # Image doğrudan Nexus registry adresiyle tagleniyor.
                            # Böylece build sonrasında ayrıca docker tag çalıştırmaya
                            # gerek kalmadan image push edilmeye hazır oluyor.
                            #
                            # Örnek:
                            # todo-nexus:8082/todo-backend:pr-48
                            # todo-nexus:8082/todo-frontend:pr-49

                            docker build \
                                -t ${NEXUS_REGISTRY}/${IMAGE_NAME}:${IMAGE_TAG} \
                                .
                        '''
                    }

                    echo "Docker image build completed successfully."

                    withCredentials([
                        usernamePassword(
                            credentialsId: 'nexus-creds',
                            usernameVariable: 'NEXUS_USERNAME',
                            passwordVariable: 'NEXUS_PASSWORD'
                        )
                    ]) {

                        sh '''
                            # Jenkins agent Nexus registry'ye kendi Nexus kullanıcısıyla giriş yapar.
                            # Şifre komut satırında açık şekilde verilmez;
                            # password-stdin üzerinden Docker'a aktarılır.

                            echo "$NEXUS_PASSWORD" | docker login ${NEXUS_REGISTRY} \
                                -u "$NEXUS_USERNAME" \
                                --password-stdin

                            # Build edilen PR image'ı Nexus hosted Docker repository'ye gönderilir.
                            #
                            # Örnek:
                            # todo-nexus:8082/todo-backend:pr-48

                            docker push \
                                ${NEXUS_REGISTRY}/${IMAGE_NAME}:${IMAGE_TAG}

                            # Push işlemi tamamlandıktan sonra agent üzerindeki
                            # registry oturumu temizlenir.

                            docker logout ${NEXUS_REGISTRY}
                        '''
                    }

                    echo "Docker image pushed successfully."
                    echo "Nexus image: ${env.NEXUS_REGISTRY}/${env.IMAGE_NAME}:${env.IMAGE_TAG}"
                }
            }
        }

        stage('Run Version Updater') {
            steps {
                script {

                    echo "PR was merged successfully."
                    echo "Starting Version-updater..."
                    echo "Module: ${env.MODULE_JOB}"

                    def versionBuild = build(
                        job: 'Version-updater',
                        parameters: [
                            string(
                                name: 'MODE',
                                value: 'MODULE'
                            ),
                            string(
                                name: 'MODULE',
                                value: env.MODULE_JOB
                            )
                        ],
                        wait: true,
                        propagate: false
                    )

                    echo "Version Updater build #${versionBuild.number}"
                    echo "Version Updater result: ${versionBuild.result}"

                    if (versionBuild.result != 'SUCCESS') {

                        error(
                            "Version Updater failed for ${env.MODULE_JOB}."
                        )
                    }

                    echo "Version Updater completed successfully."
                }
            }
        }
    }

    post {

        success {
            echo "PR Pipeline SUCCESS."
        }

        failure {
            echo "PR Pipeline FAILED."
        }

        aborted {
            echo "PR Pipeline ABORTED."
        }

        always {
            cleanWs()
        }
    }
}