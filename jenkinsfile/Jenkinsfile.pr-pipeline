pipeline {
    agent {
        node {
            label 'todo-jenkins-agent'
        }
    }

    stages {

        stage('Identify Target Module') {
            steps {
                script {
                    echo "PR ID          : ${env.CHANGE_ID}"
                    echo "Source Branch  : ${env.CHANGE_BRANCH}"
                    echo "Target Branch  : ${env.CHANGE_TARGET}"

                    if (env.CHANGE_TARGET == 'backend-module') {
                        env.MODULE_JOB = 'backend-module'
                    }
                    else if (env.CHANGE_TARGET == 'frontend-module') {
                        env.MODULE_JOB = 'frontend-module'
                    }
                    else {
                        error(
                            "Unsupported target branch: ${env.CHANGE_TARGET}. " +
                            "PR must target backend-module or frontend-module."
                        )
                    }

                    echo "Selected Module Job: ${env.MODULE_JOB}"
                }
            }
        }

        stage('Run Module Pipeline') {
            steps {
                script {
                    echo "Starting ${env.MODULE_JOB} pipeline..."
                    echo "Passing PR_NUMBER: ${env.CHANGE_ID}"

                    def moduleBuild = build(
                        job: env.MODULE_JOB,
                        parameters: [
                            string(
                                name: 'PR_NUMBER',
                                value: env.CHANGE_ID
                            )
                        ],
                        wait: true,
                        propagate: false
                    )

                    echo "Module build #${moduleBuild.number}"
                    echo "Module build result: ${moduleBuild.result}"

                    if (moduleBuild.result != 'SUCCESS') {
                        error(
                            "${env.MODULE_JOB} pipeline failed. " +
                            "PR cannot be merged."
                        )
                    }

                    echo "${env.MODULE_JOB} pipeline completed successfully."
                }
            }
        }

        stage('Check Version Updater') {
            steps {
                script {
                    echo "Checking Version Updater result for PR #${env.CHANGE_ID}..."

                    def versionJob = Jenkins.instance.getItemByFullName('version-updater')

                    if (versionJob == null) {
                        error("Version Updater job not found.")
                    }

                    def matchingBuild = versionJob.builds.find { build ->
                        def paramsAction = build.getAction(hudson.model.ParametersAction)

                        if (paramsAction == null) {
                            return false
                        }

                        def prParam = paramsAction.getParameter('PR_NUMBER')

                        return prParam != null &&
                            prParam.value.toString() == env.CHANGE_ID
                    }

                    if (matchingBuild == null) {
                        error(
                            "No Version Updater build found for PR #${env.CHANGE_ID}."
                        )
                    }

                    echo "Version Updater build #${matchingBuild.number}"
                    echo "Version Updater result: ${matchingBuild.result}"

                    if (matchingBuild.result != hudson.model.Result.SUCCESS) {
                        error(
                            "Version Updater did not complete successfully. " +
                            "Build #${matchingBuild.number} result: ${matchingBuild.result}"
                        )
                    }

                    echo "Version Updater completed successfully."
                    echo "Version Updater build #${matchingBuild.number} is SUCCESS."
                }
            }
        }
    }

    post {

        success {
            echo "PR checks SUCCESS."
            echo "You can now merge this Pull Request from GitHub."
        }

        failure {
            echo "PR checks FAILED."
            echo "Pull Request should not be merged."
        }

        aborted {
            echo "PR checks ABORTED."
        }

        always {
            cleanWs()
        }
    }
}