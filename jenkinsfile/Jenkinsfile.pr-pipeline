pipeline {
    agent {
        node {
            label 'todo-jenkins-agent'
        }
    }

    stages {

        stage('Identify Target Module') {
            steps {
                script {
                    echo "PR ID          : ${env.CHANGE_ID}"
                    echo "Source Branch  : ${env.CHANGE_BRANCH}"
                    echo "Target Branch  : ${env.CHANGE_TARGET}"

                    if (env.CHANGE_TARGET == 'backend-module') {
                        env.MODULE_JOB = 'backend-module'
                    }
                    else if (env.CHANGE_TARGET == 'frontend-module') {
                        env.MODULE_JOB = 'frontend-module'
                    }
                    else {
                        error(
                            "Unsupported target branch: ${env.CHANGE_TARGET}. " +
                            "PR must target backend-module or frontend-module."
                        )
                    }

                    echo "Selected Module Job: ${env.MODULE_JOB}"
                }
            }
        }

        stage('Run Module Pipeline') {
            steps {
                script {
                    echo "Starting ${env.MODULE_JOB} pipeline..."
                    echo "Passing PR_NUMBER: ${env.CHANGE_ID}"

                    def moduleBuild = build(
                        job: env.MODULE_JOB,
                        parameters: [
                            string(
                                name: 'PR_NUMBER',
                                value: env.CHANGE_ID
                            )
                        ],
                        wait: true,
                        propagate: false
                    )

                    echo "Module build #${moduleBuild.number}"
                    echo "Module build result: ${moduleBuild.result}"

                    if (moduleBuild.result != 'SUCCESS') {

                        publishChecks(
                            name: 'Module Pipeline',
                            title: 'Module Pipeline Failed',
                            summary: "${env.MODULE_JOB} pipeline failed. PR cannot be merged.",
                            text: "Module build #${moduleBuild.number} finished with result: ${moduleBuild.result}",
                            status: 'COMPLETED',
                            conclusion: 'FAILURE'
                        )

                        error(
                            "${env.MODULE_JOB} pipeline failed. " +
                            "PR cannot be merged."
                        )
                    }
                    else {

                        publishChecks(
                            name: 'Module Pipeline',
                            title: 'Module Pipeline Passed',
                            summary: "${env.MODULE_JOB} pipeline completed successfully.",
                            text: "Module build #${moduleBuild.number} completed successfully.",
                            status: 'COMPLETED',
                            conclusion: 'SUCCESS'
                        )

                        echo "GitHub Check 'Module Pipeline' published successfully."
                    }
                }
            }
        }

        stage('Check PR Merge Status') {
            steps {
                script {
                    echo "Checking merge status for PR #${env.CHANGE_ID}..."

                    withCredentials([
                        usernamePassword(
                            credentialsId: 'github-creds',
                            usernameVariable: 'GITHUB_USER',
                            passwordVariable: 'GITHUB_TOKEN'
                        )
                    ]) {
                        def response = sh(
                            script: """
                                curl -s \
                                -u "\${GITHUB_USER}:\${GITHUB_TOKEN}" \
                                -H "Accept: application/vnd.github+json" \
                                -H "X-GitHub-Api-Version: 2022-11-28" \
                                "https://api.github.com/repos/denizhansan/todo-list/pulls/${env.CHANGE_ID}"
                            """,
                            returnStdout: true
                        ).trim()

                        def prData = new groovy.json.JsonSlurper().parseText(response)

                        env.PR_MERGED = String.valueOf(prData.merged)

                        echo "PR #${env.CHANGE_ID} merged status: ${env.PR_MERGED}"
                    }
                }
            }
        }

        stage('Check Version Updater') {
            when {
                expression {
                    return env.PR_MERGED == 'true'
                }
            }

            steps {
                script {
                    echo "PR is merged."
                    echo "Checking Version Updater result..."

                    /*
                    * Version Updater kontrolü burada olacak.
                    */

                    echo "Waiting for Version Updater result..."
                }
            }
        }
    }

    post {

        success {
            echo "PR checks SUCCESS."
            echo "Module Pipeline check has passed."
        }

        failure {
            echo "PR checks FAILED."
            echo "Module Pipeline check has failed."
        }

        aborted {
            echo "PR checks ABORTED."
        }

        always {
            cleanWs()
        }
    }
}