pipeline {
    agent {
        node {
            label 'todo-jenkins-agent'
        }
    }

    stages {

        stage('Identify Module') {
            steps {
                script {
                    def payload = readJSON text: env.RAW_PAYLOAD

                    def action = payload.action
                    def merged = payload.pull_request.merged
                    def targetBranch = payload.pull_request.base.ref

                    echo "PR action: ${action}"
                    echo "PR merged: ${merged}"
                    echo "Target branch: ${targetBranch}"

                    if (action != 'closed' || merged != true) {
                        error "PR was closed but not merged."
                    }

                    if (
                        targetBranch != 'backend-module' &&
                        targetBranch != 'frontend-module'
                    ) {
                        error "Unsupported target branch: ${targetBranch}"
                    }

                    env.MODULE = targetBranch

                    echo "Selected module: ${env.MODULE}"
                }
            }
        }

        stage('Checkout DevOps Branch') {
            steps {
                checkout([
                    $class: 'GitSCM',
                    branches: [[name: '*/devops']],
                    userRemoteConfigs: [[
                        url: 'https://github.com/denizhansan/todo-list.git',
                        credentialsId: 'github-creds'
                    ]]
                ])
            }
        }

        stage('Update Version') {
            steps {
                script {
                    if (!fileExists('version.yaml')) {
                        error 'version.yaml not found in devops branch!'
                    }

                    sh '''
                        echo "Current versions:"
                        yq '.versions' version.yaml

                        MODULE_VERSION=$(yq ".versions.\\"${MODULE}\\"" version.yaml)
                        TODO_VERSION=$(yq '.versions."todo-app"' version.yaml)

                        echo "Current ${MODULE}: ${MODULE_VERSION}"
                        echo "Current todo-app: ${TODO_VERSION}"

                        MODULE_MAJOR=$(echo "${MODULE_VERSION}" | cut -d. -f1)
                        MODULE_MINOR=$(echo "${MODULE_VERSION}" | cut -d. -f2)
                        MODULE_PATCH=$(echo "${MODULE_VERSION}" | cut -d. -f3)

                        TODO_MAJOR=$(echo "${TODO_VERSION}" | cut -d. -f1)
                        TODO_MINOR=$(echo "${TODO_VERSION}" | cut -d. -f2)
                        TODO_PATCH=$(echo "${TODO_VERSION}" | cut -d. -f3)

                        NEW_MODULE_VERSION="${MODULE_MAJOR}.${MODULE_MINOR}.$((MODULE_PATCH + 1))"
                        NEW_TODO_VERSION="${TODO_MAJOR}.${TODO_MINOR}.$((TODO_PATCH + 1))"

                        yq -i ".versions.\\"${MODULE}\\" = \\"${NEW_MODULE_VERSION}\\"" version.yaml
                        yq -i '.versions."todo-app" = "'${NEW_TODO_VERSION}'"' version.yaml

                        echo "Updated versions:"
                        yq '.versions' version.yaml
                    '''
                }
            }
        }

        stage('Commit & Push') {
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: 'github-creds',
                        usernameVariable: 'GIT_USERNAME',
                        passwordVariable: 'GIT_PASSWORD'
                    )
                ]) {
                    sh '''
                        git config user.name "Jenkins"
                        git config user.email "jenkins@localhost"

                        git add version.yaml

                        git commit -m "chore: update ${MODULE} version"

                        git push https://${GIT_USERNAME}:${GIT_PASSWORD}@github.com/denizhansan/todo-list.git HEAD:devops
                    '''
                }
            }
        }
    }

    post {
        success {
            echo 'Version updater pipeline SUCCESS.'
        }

        failure {
            echo 'Version updater pipeline FAILED.'
        }

        always {
            cleanWs()
        }
    }
}