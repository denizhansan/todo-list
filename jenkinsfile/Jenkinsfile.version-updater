pipeline {
    agent {
        node {
            label 'todo-jenkins-agent'
        }
    }

    parameters {
        choice(
            name: 'MODULE',
            choices: [
                'backend-module',
                'frontend-module'
            ],
            description: 'Module to update'
        )

        string(
            name: 'TARGET_BRANCH',
            defaultValue: 'develop',
            description: 'Branch where the PR was merged'
        )
    }

    stages {

        stage('Checkout') {
            steps {
                checkout([
                    $class: 'GitSCM',
                    branches: [[name: "*/${params.TARGET_BRANCH}"]],
                    userRemoteConfigs: [[
                        url: 'https://github.com/denizhansan/todo-list.git',
                        credentialsId: 'github-creds'
                    ]]
                ])
            }
        }

        stage('Update Version') {
            steps {
                script {

                    def versionFile = 'version.yaml'

                    if (!fileExists(versionFile)) {
                        error "version.yaml not found!"
                    }

                    echo "Updating module: ${params.MODULE}"
                    echo "Target branch: ${params.TARGET_BRANCH}"

                    def module = params.MODULE

                    def versionContent = readFile(versionFile)

                    def modulePattern = /(?m)^(\s*${module}:\s*)(\d+)\.(\d+)\.(\d+)\s*$/
                    def todoPattern = /(?m)^(\s*todo-app:\s*)(\d+)\.(\d+)\.(\d+)\s*$/

                    def moduleMatch = (versionContent =~ modulePattern)

                    if (!moduleMatch.find()) {
                        error "Version for ${module} not found in ${versionFile}"
                    }

                    def todoMatch = (versionContent =~ todoPattern)

                    if (!todoMatch.find()) {
                        error "Version for todo-app not found in ${versionFile}"
                    }

                    def moduleMajor = moduleMatch.group(2).toInteger()
                    def moduleMinor = moduleMatch.group(3).toInteger()
                    def modulePatch = moduleMatch.group(4).toInteger()

                    def todoMajor = todoMatch.group(2).toInteger()
                    def todoMinor = todoMatch.group(3).toInteger()
                    def todoPatch = todoMatch.group(4).toInteger()

                    def oldModuleVersion =
                        "${moduleMajor}.${moduleMinor}.${modulePatch}"

                    def oldTodoVersion =
                        "${todoMajor}.${todoMinor}.${todoPatch}"

                    modulePatch++
                    todoPatch++

                    def newModuleVersion =
                        "${moduleMajor}.${moduleMinor}.${modulePatch}"

                    def newTodoVersion =
                        "${todoMajor}.${todoMinor}.${todoPatch}"

                    versionContent = versionContent.replaceFirst(
                        modulePattern,
                        "\$1${newModuleVersion}"
                    )

                    versionContent = versionContent.replaceFirst(
                        todoPattern,
                        "\$1${newTodoVersion}"
                    )

                    writeFile(
                        file: versionFile,
                        text: versionContent
                    )

                    echo "${module}: ${oldModuleVersion} -> ${newModuleVersion}"
                    echo "todo-app: ${oldTodoVersion} -> ${newTodoVersion}"
                }
            }
        }

        stage('Commit & Push') {
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: 'github-creds',
                        usernameVariable: 'GIT_USERNAME',
                        passwordVariable: 'GIT_PASSWORD'
                    )
                ]) {
                    sh '''
                        git config user.name "Jenkins"
                        git config user.email "jenkins@localhost"

                        git add version.yaml

                        git commit -m "chore: update ${MODULE} version"

                        git push https://${GIT_USERNAME}:${GIT_PASSWORD}@github.com/denizhansan/todo-list.git HEAD:${TARGET_BRANCH}
                    '''
                }
            }
        }
    }

    post {

        success {
            echo 'Version updater pipeline SUCCESS.'
        }

        failure {
            echo 'Version updater pipeline FAILED.'
        }

        always {
            cleanWs()
        }
    }
}