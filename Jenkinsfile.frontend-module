pipeline {
    agent {
        node {
            label 'todo-jenkins-agent'
        }
    }

    stages {

        stage('Read Version') {
            steps {
                script {
                    sh '''
                        git fetch origin develop:refs/remotes/origin/develop
                        git show origin/develop:version.yaml > version.yaml

                        echo "===== version.yaml ====="
                        cat version.yaml
                        echo "========================"
                    '''

                    def frontendVersion = sh(
                        script: """
                            grep '^[[:space:]]*frontend-module:' version.yaml | \
                            sed 's/.*frontend-module:[[:space:]]*//'
                        """,
                        returnStdout: true
                    ).trim()

                    if (!frontendVersion) {
                        error('version.yaml içerisinde frontend-module version bulunamadı.')
                    }

                    env.FRONTEND_VERSION = frontendVersion

                    echo "Frontend version: ${env.FRONTEND_VERSION}"
                }
            }
        }

        stage('Frontend Docker Build') {
            steps {
                dir('frontend') {
                    sh '''
                        docker build \
                            -t denizhansan/todo-frontend:${FRONTEND_VERSION} \
                            .
                    '''
                }
            }
        }
    }

    post {

        success {
            echo 'Frontend module pipeline SUCCESS.'
        }

        failure {
            echo 'Frontend module pipeline FAILED.'
        }

        always {
            sh '''
                if [ -n "${FRONTEND_VERSION}" ]; then
                    docker image rm denizhansan/todo-frontend:${FRONTEND_VERSION} || true
                fi
            '''

            cleanWs()
        }
    }
}