pipeline {
    agent {
        node {
            label 'todo-jenkins-agent'
        }
    }

    parameters {
        string(
            name: 'PR_NUMBER',
            description: 'Pull Request number'
        )
    }
    stages {

        stage('Checkout') {
            steps {
                checkout([
                    $class: 'GitSCM',
                    branches: [[name: "refs/remotes/origin/pr/${params.PR_NUMBER}/head"]],
                    userRemoteConfigs: [[
                        url: 'https://github.com/denizhansan/todo-list.git',
                        credentialsId: 'github-creds',
                        refspec: "+refs/pull/${params.PR_NUMBER}/head:refs/remotes/origin/pr/${params.PR_NUMBER}/head"
                    ]]
                ])
            }
        }

        stage('Read Version') {
            steps {
                script {
                    env.BACKEND_VERSION = "pr-${params.PR_NUMBER}"

                    echo "PR number: ${params.PR_NUMBER}"
                    echo "Backend version: ${env.BACKEND_VERSION}"
                }
            }
        }

        stage('Backend Docker Build') {
            steps {
                dir('backend') {
                    sh '''
                        docker build \
                            -t denizhansan/todo-backend:${BACKEND_VERSION} \
                            .
                    '''
                }
            }
        }
    }

    post {

        success {
            echo 'Backend module pipeline SUCCESS.'
        }

        failure {
            echo 'Backend module pipeline FAILED.'
        }

        always {
            sh '''
                docker image rm denizhansan/todo-backend:${BACKEND_VERSION} || true
            '''

            cleanWs()
        }
    }
}