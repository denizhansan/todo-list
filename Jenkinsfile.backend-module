pipeline {
    agent {
        node {
            label 'todo-jenkins-agent'
        }
    }

    parameters {
        string(
            name: 'SOURCE_BRANCH',
            defaultValue: 'backend-module',
            description: 'Build edilecek branch'
        )
    }

    stages {

        stage('Checkout') {
            steps {
                checkout([
                    $class: 'GitSCM',
                    branches: [[name: "*/${params.SOURCE_BRANCH}"]],
                    userRemoteConfigs: [[
                        url: 'https://github.com/denizhansan/todo-list.git',
                        credentialsId: 'github-credentials'
                    ]]
                ])
            }
        }

        stage('Backend Docker Build') {
            steps {
                dir('backend') {
                    sh '''
                        docker build -t denizhansan/todo-backend:${BUILD_NUMBER} .
                    '''
                }
            }
        }
    }

    post {
        success {
            echo 'Backend module pipeline SUCCESS.'
        }

        failure {
            echo 'Backend module pipeline FAILED'
        }

        always {
            sh '''
                docker image rm denizhansan/todo-backend:${BUILD_NUMBER} || true
            '''

            cleanWs()
        }
    }
}