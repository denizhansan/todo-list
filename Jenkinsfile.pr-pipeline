/*
  PR-Pipeline
  -----------
  Tetikleyici : Generic Webhook Trigger (GitHub PR webhook'u)
  Branch      : develop
  Görev       : PR'ın hangi modüle ait olduğunu tespit et, ilgili module
                pipeline'ını çalıştır, onay al, develop'a merge et,
                Version-Updater'ı çağır, Docker image build & push yap.

  Generic Webhook Trigger ayarları (Jenkins job configure):
    Post content parameters:
      - Variable: SOURCE_BRANCH  | Expression: $.pull_request.head.ref
      - Variable: PR_NUMBER      | Expression: $.pull_request.number
      - Variable: PR_ACTION      | Expression: $.action
    Token: pr-pipeline-token
    Optional filter:
      - Expression : ^(opened|synchronize|reopened)$
      - Text       : $PR_ACTION
*/

pipeline {
    agent {
        node { label 'todo-jenkins-agent' }
    }

    environment {
        GITHUB_REPO    = 'denizhansan/todo-list'
        GITHUB_API_URL = 'https://api.github.com'
        TARGET_BRANCH  = 'develop'
    }

    stages {

        // ------------------------------------------------------------------
        // 1. PR'ın hangi modüle ait olduğunu tespit et
        // ------------------------------------------------------------------
        stage('Detect Module') {
            steps {
                script {
                    if (!env.SOURCE_BRANCH) {
                        error("SOURCE_BRANCH alınamadı. Generic Webhook Trigger ayarlarını kontrol et.")
                    }
                    if (!env.PR_NUMBER) {
                        error("PR_NUMBER alınamadı. Generic Webhook Trigger ayarlarını kontrol et.")
                    }

                    echo "Gelen branch  : ${env.SOURCE_BRANCH}"
                    echo "PR numarası   : ${env.PR_NUMBER}"

                    if (env.SOURCE_BRANCH == 'backend-module') {
                        env.MODULE          = 'backend-module'
                        env.MODULE_PIPELINE = 'Backend-Module-Pipeline'
                        env.DOCKER_IMAGE    = 'denizhansan/todo-backend'
                        env.DOCKERFILE_PATH = 'backend/Dockerfile'
                        env.VERSION_KEY     = 'backend-module'
                    } else if (env.SOURCE_BRANCH == 'frontend-module') {
                        env.MODULE          = 'frontend-module'
                        env.MODULE_PIPELINE = 'Frontend-Module-Pipeline'
                        env.DOCKER_IMAGE    = 'denizhansan/todo-frontend'
                        env.DOCKERFILE_PATH = 'frontend/Dockerfile'
                        env.VERSION_KEY     = 'frontend-module'
                    } else {
                        error("Desteklenmeyen branch: '${env.SOURCE_BRANCH}'. Sadece 'backend-module' ve 'frontend-module' destekleniyor.")
                    }

                    echo "Tespit edilen modül : ${env.MODULE}"
                }
            }
        }

        // ------------------------------------------------------------------
        // 2. İlgili module pipeline'ını çalıştır ve sonucunu bekle
        // ------------------------------------------------------------------
        stage('Run Module Pipeline') {
            steps {
                script {
                    echo "${env.MODULE_PIPELINE} çalıştırılıyor..."

                    def moduleResult = build(
                        job: env.MODULE_PIPELINE,
                        wait: true,
                        propagate: false
                    )

                    if (moduleResult.result != 'SUCCESS') {
                        error("${env.MODULE} pipeline '${moduleResult.result}' ile sonuçlandı. PR merge edilmeyecek, workflow durduruluyor.")
                    }

                    echo "${env.MODULE} pipeline başarıyla tamamlandı."
                }
            }
        }

        // ------------------------------------------------------------------
        // 3. Manuel onay al
        // ------------------------------------------------------------------
        stage('Manual Approval') {
            steps {
                script {
                    input(
                        message: "${env.MODULE} testleri başarıyla tamamlandı.\n\nPull Request #${env.PR_NUMBER}, develop branch'ine merge edilsin mi?",
                        ok: 'Proceed'
                    )
                }
            }
        }

        // ------------------------------------------------------------------
        // 4. PR'ı develop branch'ine merge et (GitHub API)
        // ------------------------------------------------------------------
        stage('Merge PR to Develop') {
            steps {
                script {
                    withCredentials([usernamePassword(
                        credentialsId: 'github-creds',
                        usernameVariable: 'GITHUB_USERNAME',
                        passwordVariable: 'GITHUB_TOKEN'
                    )]) {
                        def httpCode = sh(
                            script: """
                                curl -s -o /tmp/merge_response.json -w "%{http_code}" \\
                                    -X PUT \\
                                    -H "Authorization: token \$GITHUB_TOKEN" \\
                                    -H "Accept: application/vnd.github.v3+json" \\
                                    -H "Content-Type: application/json" \\
                                    -d '{"commit_title":"Merge ${env.MODULE} into develop [skip ci]","merge_method":"merge"}' \\
                                    "${GITHUB_API_URL}/repos/${GITHUB_REPO}/pulls/${env.PR_NUMBER}/merge"
                            """,
                            returnStdout: true
                        ).trim()

                        def responseBody = sh(
                            script: 'cat /tmp/merge_response.json',
                            returnStdout: true
                        ).trim()

                        if (httpCode != '200') {
                            error("PR merge başarısız. HTTP ${httpCode}: ${responseBody}")
                        }

                        echo "PR #${env.PR_NUMBER} başarıyla develop branch'ine merge edildi."
                    }
                }
            }
        }

        // ------------------------------------------------------------------
        // 5. Version-Updater'ı çalıştır
        // ------------------------------------------------------------------
        stage('Run Version-Updater') {
            steps {
                script {
                    echo "Version-Updater çalıştırılıyor. Modül: ${env.MODULE}"

                    def versionResult = build(
                        job: 'Version-Updater',
                        wait: true,
                        propagate: false,
                        parameters: [
                            string(name: 'MODULE', value: env.MODULE)
                        ]
                    )

                    if (versionResult.result != 'SUCCESS') {
                        error("Version-Updater '${versionResult.result}' ile sonuçlandı.")
                    }

                    echo "Version-Updater başarıyla tamamlandı."
                }
            }
        }

        // ------------------------------------------------------------------
        // 6. Güncellenmiş versiyonu version.yaml'dan oku
        // ------------------------------------------------------------------
        stage('Read Updated Version') {
            steps {
                script {
                    withCredentials([usernamePassword(
                        credentialsId: 'github-creds',
                        usernameVariable: 'GITHUB_USERNAME',
                        passwordVariable: 'GITHUB_TOKEN'
                    )]) {
                        // develop branch'indeki version.yaml'ı GitHub API üzerinden oku
                        def moduleVersion = sh(
                            script: """
                                curl -s \\
                                    -H "Authorization: token \$GITHUB_TOKEN" \\
                                    -H "Accept: application/vnd.github.v3+json" \\
                                    "${GITHUB_API_URL}/repos/${GITHUB_REPO}/contents/version.yaml?ref=develop" \\
                                | jq -r '.content' \\
                                | base64 -d \\
                                | grep '^${env.VERSION_KEY}:' \\
                                | awk '{print \$2}'
                            """,
                            returnStdout: true
                        ).trim()

                        if (!moduleVersion) {
                            error("version.yaml'dan '${env.VERSION_KEY}' versiyonu okunamadı.")
                        }

                        env.MODULE_VERSION = moduleVersion
                        env.DOCKER_TAG     = "${moduleVersion}-dev"

                        echo "Güncel modül versiyonu : ${env.MODULE_VERSION}"
                        echo "Docker tag             : ${env.DOCKER_TAG}"
                    }
                }
            }
        }

        // ------------------------------------------------------------------
        // 7. Docker image build et ve Docker Hub'a push et
        // ------------------------------------------------------------------
        stage('Docker Build and Push') {
            steps {
                script {
                    // Merge sonrası develop branch'ini checkout et
                    checkout([
                        $class: 'GitSCM',
                        branches: [[name: "refs/heads/${TARGET_BRANCH}"]],
                        userRemoteConfigs: [[
                            url: "https://github.com/${GITHUB_REPO}.git",
                            credentialsId: 'github-creds'
                        ]]
                    ])

                    withCredentials([usernamePassword(
                        credentialsId: 'dockerhub-creds',
                        usernameVariable: 'DOCKER_USERNAME',
                        passwordVariable: 'DOCKER_PASSWORD'
                    )]) {
                        sh """
                            echo \$DOCKER_PASSWORD | docker login -u \$DOCKER_USERNAME --password-stdin

                            docker build \\
                                -t ${env.DOCKER_IMAGE}:${env.DOCKER_TAG} \\
                                -f ${env.DOCKERFILE_PATH} \\
                                .

                            docker push ${env.DOCKER_IMAGE}:${env.DOCKER_TAG}

                            docker logout
                        """
                    }

                    echo "Docker image başarıyla push edildi: ${env.DOCKER_IMAGE}:${env.DOCKER_TAG}"
                }
            }
        }
    }

    post {
        success {
            echo "Pipeline tamamlandı. Image: ${env.DOCKER_IMAGE}:${env.DOCKER_TAG}"
        }
        failure {
            echo "Pipeline başarısız oldu. Logları kontrol et."
        }
        aborted {
            echo "Pipeline iptal edildi. PR merge edilmedi."
        }
    }
}
